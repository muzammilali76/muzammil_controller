<?xml version="1.0"?>
<package format="3">
  <name>muzammil_controller</name>
  <version>1.1.0</version>
  <description>Horizon-weighted disparity gap autonomous racing controller with corridor centering and TTC speed regulation for the CIE-KFUPM F1TENTH competition.</description>
  <maintainer email="muzammilalimkd@gmail.com">Muzammil Ali</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>ackermann_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
